# Copy to .env before running `npm run dev` (.env is gitignored - never commit it).
PORT=3000
DATABASE_URL=postgresql://eventify:eventify@localhost:5432/eventify
# Windows: if 5432 is reserved or occupied (netsh shows 5433-5532 excluded), set POSTGRES_HOST_PORT=6000
# in your .env and change DATABASE_URL to ...@localhost:6000/eventify
POSTGRES_HOST_PORT=5432
