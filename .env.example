# Copy to .env before running `npm run dev` (.env is gitignored - never commit it).
# PORT defaults to 3000 when unset; the API binds to it in every environment.
PORT=3000
# Windows: if 5432 is reserved or occupied (netsh shows 5433-5532 excluded), set POSTGRES_HOST_PORT=6000
# in your .env and change DATABASE_URL to ...@localhost:6000/eventify
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://eventify:eventify@localhost:5432/eventify

# Required: HS256 signing secret for access JWTs. Must be >= 32 chars.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# Redis connection for cache, rate limiting, and BullMQ
REDIS_URL=redis://localhost:6379

# Origins allowed to receive the refresh cookie (e.g. Next.js frontend).
WEB_ORIGIN=http://localhost:3001

# TEST-ONLY. Set to "true" to let parallel test scripts identify users
# via the X-User-Id header without a real JWT. NEVER enable in production.
TEST_AUTH_ENABLED=false
