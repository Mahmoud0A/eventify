{
  "name": "eventify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eventify - the event booking API built across the course",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "lint": "eslint .",
    "test": "vitest run",
    "test:frontend": "npm --prefix frontend run test",
    "test:all": "npm test && npm run test:frontend",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.30.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^7.9.1",
    "redis": "^6.2.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  }
}
